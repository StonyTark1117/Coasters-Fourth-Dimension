+  public static void diagnoseRightClick(PlayerInteractEvent.RightClickBlock event) {
+    if (!Boolean.getBoolean("fourthdimension.validation")) return;
+    var pos = event.getPos();
+    try {
+      var level = event.getLevel();
+      var binding = Boarding.at(level, pos);
+      System.out.println("FD_SEAT_EVENT side=" + (level.isClientSide ? "client" : "server")
+          + " pos=" + pos + " block=" + level.getBlockState(pos).getBlock()
+          + " binding=" + (binding != null)
+          + " ready=" + (binding != null && (level instanceof net.minecraft.server.level.ServerLevel server
+              ? Boarding.ready(server, binding.vehicle()) : binding.vehicle().boardingReady))
+          + " restraints=" + (binding != null && binding.vehicle().restraints)
+          + " occupied=" + SeatBlock.isSeatOccupied(level, pos)
+          + " reach=" + event.getEntity().canInteractWithBlock(pos, 0.0));
