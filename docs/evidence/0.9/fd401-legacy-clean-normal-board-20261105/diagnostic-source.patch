+  public static void diagnoseTarget(ServerTickEvent.Post event) {
+    if (targetReported || !Boolean.getBoolean("fourthdimension.validation")) return;
+    var level = event.getServer().overworld();
+    var player = event.getServer().getPlayerList().getPlayerByName("Dev");
+    if (player == null || Math.abs(player.getX() - 197.5) > 1.0
+        || Math.abs(player.getZ() - 32.5) > 1.0) return;
+    if (targetTicks++ < 100) return;
+    var target = new BlockPos(20481032, 127, 20491273);
+    var helper = new BlockPos(20481032, 127, 20489223);
+    try {
+      for (var pos : new BlockPos[] {target, helper}) {
+        var body = dev.ryanhcode.sable.Sable.HELPER.getContaining(level, pos);
+        var binding = Boarding.at(level, pos);
+        var offset = body == null ? null : pos.subtract(body.getPlot().getCenterBlock());
+        System.out.println("FD_SEAT_TARGET_STATE pos=" + pos
+            + " block=" + level.getBlockState(pos).getBlock()
+            + " body=" + (body == null ? "null" : body.getUniqueId())
+            + " binding=" + (binding != null)
+            + " family=" + (binding == null ? "null" : binding.vehicle().family)
+            + " ready=" + (binding != null && Boarding.ready(level, binding.vehicle()))
+            + " restraints=" + (binding != null && binding.vehicle().restraints)
+            + " canBoard=" + Boarding.canBoard(level, pos)
+            + " occupied=" + SeatBlock.isSeatOccupied(level, pos)
+            + " offset=" + offset
+            + " known=" + (binding != null && binding.carrier().seats.contains(offset))
+            + " reach=" + player.canInteractWithBlock(pos, 0.0));
+      }
+      targetReported = true;
+    } catch (RuntimeException ex) {
+      System.out.println("FD_SEAT_TARGET_EXCEPTION " + ex);
+      targetReported = true;
+    }
+  }
